# Définition des types de comptes
enum AccountType {
    CHECKING
    SAVINGS
}

# Objet représentant un compte bancaire
type BankAccount {
    id: ID
    balance: Float
    creationDate: String
    accountType: AccountType
}

# Type pour les statistiques globales des comptes
type AccountStats {
    totalCount: Int
    totalBalance: Float
    averageBalance: Float
}

# Requêtes disponibles
type Query {
    listAccounts: [BankAccount]
    getAccount(id: ID!): BankAccount
    getAccountStats: AccountStats
}

# Input pour créer un compte
input BankAccountInput {
    balance: Float!
    creationDate: String!
    accountType: AccountType!
}

# Mutations disponibles
type Mutation {
    createAccount(account: BankAccountInput): BankAccount
}

# Enum pour les types de transaction
enum TransactionKind {
    DEPOSIT
    WITHDRAWAL
}

# Type pour une transaction bancaire
type BankTransaction {
    id: ID
    transactionDate: String
    amount: Float
    transactionKind: TransactionKind
    account: BankAccount
}

# Input pour ajouter une transaction
input BankTransactionInput {
    accountId: ID!
    amount: Float!
    transactionDate: String!
    transactionKind: TransactionKind!
}

# Type pour les statistiques de transaction
type BankTransactionStats {
    totalCount: Int
    totalDeposits: Float
    totalWithdrawals: Float
}

# Extensions des requêtes
extend type Query {
    getAccountTransactions(accountId: ID!): [BankTransaction]
    listTransactions: [BankTransaction]
    getTransactionStats: BankTransactionStats
}

# Extensions des mutations
extend type Mutation {
    addTransaction(transaction: BankTransactionInput): BankTransaction
}
